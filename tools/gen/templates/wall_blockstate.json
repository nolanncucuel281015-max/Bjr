{
 "multipart": [
  {
   "apply": {
    "model": "{MODEL}_post"
   },
   "when": {
    "up": "true"
   }
  },
  {
   "apply": {
    "model": "{MODEL}_side",
    "uvlock": true
   },
   "when": {
    "north": "low"
   }
  },
  {
   "apply": {
    "model": "{MODEL}_side",
    "uvlock": true,
    "y": 90
   },
   "when": {
    "east": "low"
   }
  },
  {
   "apply": {
    "model": "{MODEL}_side",
    "uvlock": true,
    "y": 180
   },
   "when": {
    "south": "low"
   }
  },
  {
   "apply": {
    "model": "{MODEL}_side",
    "uvlock": true,
    "y": 270
   },
   "when": {
    "west": "low"
   }
  },
  {
   "apply": {
    "model": "{MODEL}_side_tall",
    "uvlock": true
   },
   "when": {
    "north": "tall"
   }
  },
  {
   "apply": {
    "model": "{MODEL}_side_tall",
    "uvlock": true,
    "y": 90
   },
   "when": {
    "east": "tall"
   }
  },
  {
   "apply": {
    "model": "{MODEL}_side_tall",
    "uvlock": true,
    "y": 180
   },
   "when": {
    "south": "tall"
   }
  },
  {
   "apply": {
    "model": "{MODEL}_side_tall",
    "uvlock": true,
    "y": 270
   },
   "when": {
    "west": "tall"
   }
  }
 ]
}