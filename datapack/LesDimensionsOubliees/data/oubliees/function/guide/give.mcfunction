give @s written_book[written_book_content={"title":"Grimoire des Anciens","author":"Les Architectes","pages":[[{"text":"Les Dimensions\nOubliées\n\n","color":"dark_purple","bold":true},{"text":"Grimoire des Anciens\n\n","color":"gold"},{"text":"Sept mondes perdus, une magie oubliée et votre propre légende.\n\nTournez la page.","color":"black"}],[{"text":"La magie\n\n","color":"dark_purple","bold":true},{"text":"Fabriquez un bâton : deux bâtons en diagonale et le matériau de l'école au sommet.\n\n","color":"black"},{"text":"Clic droit","color":"dark_blue","bold":true},{"text":" : lancer le sort.\n","color":"black"},{"text":"Accroupi + clic droit","color":"dark_blue","bold":true},{"text":" : sort suivant.\n\n","color":"black"},{"text":"Le sort, le mana et le niveau s'affichent au-dessus de la barre d'objets.","color":"dark_gray"}],[{"text":"Les écoles\n\n","color":"dark_purple","bold":true},{"text":"Feu","color":"gold","bold":true},{"text":" : poudre de blaze\n","color":"black"},{"text":"Glace","color":"aqua","bold":true},{"text":" : glace compactée\n","color":"black"},{"text":"Foudre","color":"yellow","bold":true},{"text":" : lingot de cuivre\n","color":"black"},{"text":"Nature","color":"dark_green","bold":true},{"text":" : émeraude\n","color":"black"},{"text":"Néant","color":"dark_purple","bold":true},{"text":" : perle de l'Ender\n\n","color":"black"},{"text":"Quatre sorts par école, débloqués avec les niveaux.","color":"dark_gray"}],[{"text":"Les voyages\n\n","color":"dark_purple","bold":true},{"text":"Une clé = un œil de l'Ender entouré de 4 matériaux de la dimension :\n","color":"black"},{"text":"Céleste : améthyste\nCorrompue : champignon cramoisi\nOcéan : cristaux de prismarine\nChaos : poudre de blaze\nÉternel : glace bleue\nProfondeurs : éclat d'écho\n","color":"dark_blue"},{"text":"Néant : étoile du Nether, souffle de dragon, éclat d'écho et œil de l'Ender.","color":"dark_purple"}],[{"text":"Voyager\n\n","color":"dark_purple","bold":true},{"text":"Maintenez clic droit avec une clé. Vous arrivez dans la dimension, protégé quelques secondes.\n\n","color":"black"},{"text":"Pour rentrer, utilisez la même clé dans cette dimension : elle vous ramène là où vous étiez.","color":"black"}],[{"text":"Le héros\n\n","color":"dark_purple","bold":true},{"text":"Chaque créature vaincue donne de l'expérience. Chaque niveau augmente votre mana et la puissance des sorts ; tous les 5 niveaux, un cœur de plus.\n\n","color":"black"},{"text":"Fiche de personnage :\n","color":"dark_blue"},{"text":"/trigger oubliees.menu","color":"dark_red"}],[{"text":"Les créatures\n\n","color":"dark_purple","bold":true},{"text":"Les créatures ont un niveau qui dépend du monde : Céleste vers 6, Néant vers 82. Plus le niveau est haut, plus elles sont robustes.\n\n","color":"black"},{"text":"Une fois touchées, leur barre de vie apparaît au-dessus d'elles et les dégâts s'affichent.","color":"dark_gray"}],[{"text":"L'armurerie\n\n","color":"dark_purple","bold":true},{"text":"Entourez une arme ou une pièce d'armure en diamant (ou netherite) de 4 matériaux d'une dimension pour obtenir sa version légendaire.\n\n","color":"black"},{"text":"Une armure complète donne un bonus permanent.","color":"dark_gray"}]]}]
